{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": [
    "src/types.ts",
    "src/data/**/*.ts",
    "src/combat/**/*.ts",
    "src/gameEvents.ts",
    "src/gameEngine.ts",
    "src/utils/**/*.ts"
  ]
}
