{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": false,
    "skipLibCheck": true,
    "outDir": "/mnt/data/life_travel_runtime",
    "rootDir": "src",
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "src/types.ts",
    "src/data/**/*.ts",
    "src/combat/**/*.ts",
    "src/gameEvents.ts",
    "src/gameEngine.ts",
    "src/utils/**/*.ts"
  ]
}
